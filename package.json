{
  "name": "ledgerflow",
  "version": "0.2.0",
  "description": "Deterministic billing rules engine and invoice simulation toolkit for SaaS teams.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ledgerflow": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-data-assets.mjs",
    "bench": "tsx scripts/bench.ts",
    "coverage": "vitest run --coverage",
    "format": "prettier --check .",
    "lint": "eslint .",
    "load:simulate": "node scripts/load-profile.mjs",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "billing",
    "invoice",
    "saas",
    "rules-engine"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@opentelemetry/api": "^1.9.1",
    "better-sqlite3": "^11.9.1",
    "commander": "^13.1.0",
    "fastify": "^5.8.5",
    "luxon": "^3.5.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "fast-check": "^4.8.0",
    "globals": "^15.15.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  }
}
