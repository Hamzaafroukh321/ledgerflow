{
  "name": "ledgerflow",
  "version": "0.1.0",
  "description": "Deterministic billing rules engine and invoice simulation toolkit for SaaS teams.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ledgerflow": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "format": "prettier --check .",
    "lint": "eslint . --ext .ts,.cjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "billing",
    "invoice",
    "saas",
    "rules-engine"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "commander": "^13.1.0",
    "fastify": "^4.29.0",
    "luxon": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
